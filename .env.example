# Copy to .data/app.env, chmod 600, then edit locally. Never use VITE_* for secrets.
APP_ORIGIN=http://localhost:5173
FOUNDRY_RESOURCE=
FOUNDRY_API_KEY=
# Logical OpenAI model: gpt-5.6-sol or gpt-6-astra.
SOLOOP_MODEL=gpt-5.6-sol
# Optional Azure deployment alias when its name differs from the logical model.
FOUNDRY_DEPLOYMENT=
# Optional local overrides:
# SOLOOP_DB=.data/soloop.db
# SOLOOP_API_PORT=8014
